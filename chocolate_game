#include <stdio.h>
int main()
{
    int chocolate,pick,player=1;
    printf("Enter number of chocolates:");
    scanf("%d",&chocolate);
    while(chocolate>0)
    {
        printf("\nPlayer %d turn\n",player);
        printf("Pick chocolates (1-3):");
        scanf("%d",&pick);
        if(pick<1 || pick>3 || pick>chocolate)
        {
            printf("Invalid choice!Try again. \n");
            continue;
        }
        chocolate=chocolate-pick;
        printf("Remaining chocolates=%d\n",chocolate);
        if(chocolate==0)
        {
            printf("\n Only Chilly remains! \n");
            if(chocolate==1)
            {
                printf("Player 2 gets chilly! \n");
                printf("Player 2 lost! \n");
                printf("Player 1 won! \n");
            }
            else
            {
                printf("Player 1 gets chilly! \n");
                printf("Player 1 lost! \n");
                printf("Player 2 won! \n");
            }
            break;
        }
     
        if (player==1)
        {
            player=2;
        }
        else
        {
            player=1;
        }
    }
    return 0;
}
     



